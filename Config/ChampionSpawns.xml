<?xml version="1.0" encoding="UTF-8"?>
<championSystem>
    <!-- Definição dos elementos de spawn (reaparecimento) de campeões.
         Abaixo estão os parâmetros que cada spawn pode conter:
         name        -> Nome exibido no jogo.
         group       -> Grupo ao qual o spawn pertence. Opcional. Se presente, apenas um spawn por grupo reinicia automaticamente.
         type        -> Tipo de spawn, definido em ChampionSpawnType.cs. Opcional. Se não definido, um tipo aleatório será selecionado.
         killsMod    -> Multiplicador aplicado ao número de inimigos que precisam ser mortos para avançar de nível.
         spawnMod    -> Multiplicador aplicado ao número de inimigos que surgem de uma vez. Opcional.
         location    -> Definição da posição do altar de spawn (centro do spawn).
            x        -> Coordenada X.
            y        -> Coordenada Y.
            z        -> Coordenada Z (altitude).
            map      -> Nome do mapa onde o spawn ocorre, deve corresponder ao definido em MapDefinitions.cs.
            radius   -> Raio da área do spawn.
    -->
    
    <!-- Exemplo de um spawn de campeões com nome, grupo e tipo definidos -->
    <spawn name="Deceit" group="FelDungeons" type="UnholyTerror">
        <location x="5178" y="708" z="20" map="Felucca" radius="60"/>
    </spawn>
    
    <!-- Outro exemplo com um tipo de spawn diferente -->
    <spawn name="Despise" group="FelDungeons" type="VerminHorde">
        <location x="5557" y="824" z="65" map="Felucca" radius="65"/>
    </spawn>

    <!-- Simplificação: Não há necessidade de type em todos os spawns, apenas os que se diferenciam. -->
    <spawn name="Destard" group="FelDungeons">
        <location x="5259" y="837" z="61" map="Felucca" radius="75"/>
    </spawn>

    <!-- Exemplo de um spawn sem modificação de kills ou spawn, para manter o padrão. -->
    <spawn name="Fire" group="FelDungeons">
        <location x="5814" y="1350" z="2" map="Felucca" radius="50"/>
    </spawn>

    <!-- Spawns com modificadores de spawnMod para ajustar o número de inimigos por vez -->
    <spawn name="Tortoise" group="FelT2A" spawnMod="0.5">
        <location x="5724" y="3991" z="42" map="Felucca" radius="20"/>
    </spawn>
    
    <spawn name="Oasis" group="FelT2A" spawnMod="0.75">
        <location x="5549" y="2640" z="15" map="Felucca" radius="25"/>
    </spawn>
    
    <!-- Exemplo de um spawn sem modificador adicional para simplificação -->
    <spawn name="Valor">
        <location x="382" y="328" z="-30" map="Ilshenar" radius="100"/>
    </spawn>
    
    <spawn name="Humility">
        <location x="462" y="926" z="-67" map="Ilshenar" radius="100"/>
    </spawn>

    <!-- Outro exemplo com killsMod e spawnMod para personalização de dificuldade -->
    <spawn name="Glade" type="Glade" killsMod="0.5" spawnMod="0.5">
        <location x="2212" y="1260" z="25" map="Ilshenar" radius="25"/>
    </spawn>
    
    <!-- Ajuste de spawn com modificador reduzido para mais dificuldade -->
    <spawn name="Bedlam" type="Corrupt" killsMod="0.5" spawnMod="0.5">
        <location x="174" y="1629" z="8" map="Malas" radius="25"/>
    </spawn>

    <!-- Outros spawns com parâmetros simplificados para manter a consistência -->
    <spawn name="Dragon" type="SleepingDragon">
        <location x="948" y="434" z="29" map="Tokuno" radius="60"/>
    </spawn>

</championSystem>
